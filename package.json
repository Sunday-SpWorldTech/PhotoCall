{
  "name": "photocall",
  "version": "4.0.0",
  "private": true,
  "description": "PhotoCall production WebRTC calling app with human-photo avatar, optional uploaded voice profile, MongoDB auth, Metered TURN and Socket.IO signaling.",
  "scripts": {
    "start": "node backend/server.js",
    "dev": "node --watch backend/server.js",
    "vercel-build": "echo PhotoCall build complete",
    "backend:dev": "npm --prefix backend run dev",
    "frontend:dev": "npm --prefix frontend run dev",
    "build:frontend": "npm --prefix frontend run build"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "socket.io": "^4.8.1",
    "busboy": "^1.6.0"
  }
}
